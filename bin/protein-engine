#!/usr/bin/env zsh
PROTEIN_HOME="${HOME}/.protein"
VAULT_DIR="${PROTEIN_HOME}/vault"
RECEPTOR_DIR="${PROTEIN_HOME}/receptors"
CORE_LOG="${PROTEIN_HOME}/evolution.log"

init_protein_root() {
    mkdir -p "${VAULT_DIR}" "${RECEPTOR_DIR}"
    touch "${CORE_LOG}"
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] [GENESIS] Protein Root Initialized at Zero-Weight." >> "${CORE_LOG}"
}

bind_symlink_receptor() {
    local receptor_name="$1"
    local target_executable="$2"
    local link_path="${RECEPTOR_DIR}/${receptor_name}"
    if [ -L "${link_path}" ]; then rm -f "${link_path}"; fi
    ln -s "${target_executable}" "${link_path}"
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] [RECEPTOR] Bound [${receptor_name}] -> [${target_executable}]" >> "${CORE_LOG}"
}

hibernation_mode() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] [HIBERNATION] Freezing state into Vault payload..." >> "${CORE_LOG}"
    local snapshot_name="state_$(date +%s).tar.gz"
    tar -czf "${VAULT_DIR}/${snapshot_name}" -C "${RECEPTOR_DIR}" . 2>/dev/null
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] [HIBERNATION] Core entering deep sleep. 0 K State reached." >> "${CORE_LOG}"
}

wake_and_evolve() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] [AWAKENING] Scanning receptor integrity and self-healing..." >> "${CORE_LOG}"
    for receptor in "${RECEPTOR_DIR}"/*(N); do
        if [ -L "${receptor}" ]; then
            local target_path="$(readlink "${receptor}")"
            if [ ! -e "${target_path}" ]; then
                echo "[$(date +'%Y-%m-%d %H:%M:%S')] [MUTATION] Broken link detected: $(basename "${receptor}"). Self-healing..." >> "${CORE_LOG}"
                rm -f "${receptor}"
            fi
        fi
    done
}

case "$1" in
    init) init_protein_root; echo "✨ Protein Genesis Core successfully planted." ;;
    bind) 
        if [ -z "$2" ] || [ -z "$3" ]; then echo "Usage: protein-engine bind <name> <target_path>"; exit 1; fi
        init_protein_root; bind_symlink_receptor "$2" "$3"; echo "🔗 Receptor '$2' successfully bound." ;;
    hibernate) hibernation_mode; echo "❄️ Core state frozen. System in 0 K Hibernation." ;;
    wake) wake_and_evolve; echo "🔥 Core awakened and synchronized." ;;
    *) echo "Usage: protein-engine {init|bind <name> <target>|hibernate|wake}"; exit 1 ;;
esac
